<Window x:Class="TrafficViolationDetection.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Traffic Violation Detection"
        Height="760"
        Width="1280"
        MinHeight="680"
        MinWidth="1100"
        WindowStartupLocation="CenterScreen"
        Background="#F4F7FB">

    <Grid>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>


        <!-- ================= SIDEBAR ================= -->

        <Border Grid.Column="0"
                Background="#10263F">

            <Grid Margin="18">

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>


                <!-- Application Title -->

                <StackPanel Margin="10,18,10,32">

                    <TextBlock Text="TRAFFIC"
                               Foreground="White"
                               FontWeight="Bold"
                               FontSize="22"/>

                    <TextBlock Text="Violation Detection"
                               Foreground="#9FB2C8"
                               FontSize="14"
                               Margin="0,4,0,0"/>

                </StackPanel>


                <!-- Navigation -->

                <StackPanel Grid.Row="1">

                    <Button Content="⌂   Dashboard"
                            Tag="Dashboard"
                            Style="{StaticResource NavButton}"
                            Click="Navigate_Click"
                            Margin="0,4"/>

                    <Button Content="▶   Detection"
                            Tag="Detection"
                            Style="{StaticResource NavButton}"
                            Click="Navigate_Click"
                            Margin="0,4"/>

                    <Button Content="⚠   Violations"
                            Tag="Violations"
                            Style="{StaticResource NavButton}"
                            Click="Navigate_Click"
                            Margin="0,4"/>

                    <Button Content="▣   Cameras"
                            Tag="Cameras"
                            Style="{StaticResource NavButton}"
                            Click="Navigate_Click"
                            Margin="0,4"/>

                    <Button Content="▥   Reports"
                            Tag="Reports"
                            Style="{StaticResource NavButton}"
                            Click="Navigate_Click"
                            Margin="0,4"/>

                </StackPanel>


                <!-- System Status -->

                <Border Grid.Row="2"
                        Background="#173653"
                        CornerRadius="10"
                        Padding="15"
                        Margin="0,15,0,5">

                    <StackPanel>

                        <TextBlock Text="SYSTEM STATUS"
                                   Foreground="#8FA7BD"
                                   FontSize="11"
                                   FontWeight="SemiBold"/>

                        <StackPanel Orientation="Horizontal"
                                    Margin="0,10,0,0">

                            <Ellipse Width="8"
                                     Height="8"
                                     Fill="#69D39E"
                                     VerticalAlignment="Center"/>

                            <TextBlock Text="Database connected"
                                       Foreground="#69D39E"
                                       Margin="8,0,0,0"
                                       VerticalAlignment="Center"/>

                        </StackPanel>

                        <TextBlock Text="SQL Server"
                                   Foreground="#B9C9D8"
                                   FontSize="12"
                                   Margin="16,5,0,0"/>

                    </StackPanel>

                </Border>

            </Grid>

        </Border>


        <!-- ================= MAIN AREA ================= -->

        <Grid Grid.Column="1">

            <Grid.RowDefinitions>
                <RowDefinition Height="72"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>


            <!-- ================= TOP HEADER ================= -->

            <Border Grid.Row="0"
                    Background="White"
                    BorderBrush="#E4E9F0"
                    BorderThickness="0,0,0,1">

                <Grid Margin="28,0">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>


                    <!-- Current Page -->

                    <TextBlock x:Name="PageTitle"
                               Grid.Column="0"
                               Text="Dashboard"
                               FontSize="24"
                               FontWeight="SemiBold"
                               Foreground="#172B4D"
                               VerticalAlignment="Center"/>


                    <!-- Right Header -->

                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                VerticalAlignment="Center">

                        <Ellipse Width="9"
                                 Height="9"
                                 Fill="#35C58B"
                                 VerticalAlignment="Center"/>

                        <TextBlock Text="System Online"
                                   Foreground="#52647A"
                                   Margin="8,0,22,0"
                                   VerticalAlignment="Center"/>

                        <Border Background="#EAF1F8"
                                CornerRadius="18"
                                Padding="15,8">

                            <TextBlock Text="Administrator"
                                       Foreground="#24415F"
                                       FontSize="13"
                                       FontWeight="Medium"/>

                        </Border>

                    </StackPanel>

                </Grid>

            </Border>


            <!-- ================= PAGE CONTENT ================= -->

            <Frame x:Name="MainFrame"
                   Grid.Row="1"
                   NavigationUIVisibility="Hidden"
                   Source="Views/DashboardView.xaml"/>

        </Grid>

    </Grid>

</Window>