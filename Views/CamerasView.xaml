<Page x:Class="TrafficViolationDetection.Views.CamerasView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="#F4F7FB">

    <Grid Margin="28">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ================= HEADER ================= -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Title -->
            <StackPanel Grid.Column="0">
                <TextBlock Text="Camera Management"
                           FontSize="20"
                           FontWeight="SemiBold"
                           Foreground="#172B4D"/>

                <TextBlock Text="Add and monitor detection sources"
                           Foreground="#6B7C93"
                           Margin="0,5,0,0"/>
            </StackPanel>

            <!-- Add Camera Button -->
            <Button Grid.Column="1"
                    Content="+ Add Camera"
                    Style="{StaticResource PrimaryButton}"
                    Width="140"
                    Height="40"
                    Margin="20,0,0,0"
                    VerticalAlignment="Center"/>
        </Grid>


        <!-- ================= CAMERA LIST ================= -->
        <WrapPanel Grid.Row="1"
                   Margin="0,25,0,0"
                   VerticalAlignment="Top">

            <!-- Camera Card -->
            <Border Style="{StaticResource Card}"
                    Width="360">

                <StackPanel>

                    <!-- Camera preview -->
                    <Border Height="180"
                            Background="#172331"
                            CornerRadius="8">

                        <Grid>

                            <TextBlock Text="CAMERA 1"
                                       Foreground="#9FB2C8"
                                       FontSize="15"
                                       FontWeight="SemiBold"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>

                            <!-- Online badge -->
                            <Border Background="#1D8360"
                                    CornerRadius="10"
                                    Padding="8,3"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Top"
                                    Margin="10">

                                <TextBlock Text="● ONLINE"
                                           Foreground="White"
                                           FontSize="10"/>

                            </Border>

                        </Grid>

                    </Border>


                    <!-- Camera information -->
                    <Grid Margin="0,18,0,0">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">

                            <TextBlock Text="Main Street Camera"
                                       FontSize="16"
                                       FontWeight="SemiBold"
                                       Foreground="#172B4D"/>

                            <TextBlock Text="Status: Online"
                                       Foreground="#2FA875"
                                       Margin="0,7,0,0"/>

                            <TextBlock Text="Last detection: 14:15:23"
                                       Foreground="#6B7C93"
                                       Margin="0,4,0,0"/>

                        </StackPanel>

                        <!-- Configure Button -->
                        <Button Grid.Column="1"
                                Content="Configure"
                                Width="100"
                                Height="36"
                                Margin="20,0,0,0"
                                Padding="12,5"
                                VerticalAlignment="Center"/>

                    </Grid>

                </StackPanel>

            </Border>

        </WrapPanel>

    </Grid>

</Page>