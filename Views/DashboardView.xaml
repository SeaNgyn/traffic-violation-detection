<Page x:Class="TrafficViolationDetection.Views.DashboardView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="#F4F7FB">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="28">

            <!-- Header -->
            <TextBlock Text="Overview"
                       FontSize="18"
                       FontWeight="SemiBold"
                       Foreground="#172B4D"/>

            <TextBlock Text="Monitoring summary for the traffic violation detection system"
                       Foreground="#6B7C93"
                       Margin="0,4,0,20"/>

            <!-- Summary Cards -->
            <UniformGrid Columns="4">

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="TOTAL DETECTIONS"
                                   Foreground="#7A8CA2"
                                   FontSize="11"/>

                        <TextBlock Text="1"
                                   FontSize="30"
                                   FontWeight="Bold"
                                   Foreground="#172B4D"
                                   Margin="0,8,0,0"/>

                        <TextBlock Text="All processed objects"
                                   Foreground="#8A99AA"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="VIOLATIONS"
                                   Foreground="#7A8CA2"
                                   FontSize="11"/>

                        <TextBlock Text="1"
                                   FontSize="30"
                                   FontWeight="Bold"
                                   Foreground="#E04F5F"
                                   Margin="0,8,0,0"/>

                        <TextBlock Text="Requires review"
                                   Foreground="#8A99AA"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="ACTIVE CAMERAS"
                                   Foreground="#7A8CA2"
                                   FontSize="11"/>

                        <TextBlock Text="1"
                                   FontSize="30"
                                   FontWeight="Bold"
                                   Foreground="#1F70C1"
                                   Margin="0,8,0,0"/>

                        <TextBlock Text="Connected sources"
                                   Foreground="#8A99AA"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="AVG. CONFIDENCE"
                                   Foreground="#7A8CA2"
                                   FontSize="11"/>

                        <TextBlock Text="95%"
                                   FontSize="30"
                                   FontWeight="Bold"
                                   Foreground="#2FA875"
                                   Margin="0,8,0,0"/>

                        <TextBlock Text="Model confidence"
                                   Foreground="#8A99AA"/>
                    </StackPanel>
                </Border>

            </UniformGrid>

            <!-- Main Content -->
            <Grid Margin="0,16,0,0">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Recent Violations -->
                <Border Grid.Column="0"
            Style="{StaticResource Card}"
            Margin="0">

                    <StackPanel>

                        <!-- Section Header -->
                        <Grid Margin="0,0,0,18">

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- Title -->
                            <StackPanel Grid.Column="0"
                            VerticalAlignment="Center">

                                <TextBlock Text="Recent Violations"
                               FontSize="16"
                               FontWeight="SemiBold"
                               Foreground="#172B4D"/>

                                <TextBlock Text="Latest detected traffic violations"
                               FontSize="12"
                               Foreground="#8A99AA"
                               Margin="0,3,0,0"/>

                            </StackPanel>

                            <!-- View All Button -->
                            <Button Grid.Column="1"
                        Content="View all"
                        Style="{StaticResource PrimaryButton}"
                        MinWidth="82"
                        Height="34"
                        Padding="14,0"
                        Margin="20,0,0,0"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"/>

                        </Grid>

                        <!-- Data Table -->
                        <DataGrid AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      IsReadOnly="True"
                      HeadersVisibility="Column"
                      GridLinesVisibility="Horizontal"
                      BorderThickness="0"
                      Height="245">

                            <DataGrid.Columns>

                                <DataGridTextColumn Header="ID"
                                        Binding="{Binding Id}"
                                        Width="55"/>

                                <DataGridTextColumn Header="Object"
                                        Binding="{Binding ObjectType}"
                                        Width="*"/>

                                <DataGridTextColumn Header="Violation"
                                        Binding="{Binding ViolationType}"
                                        Width="*"/>

                                <DataGridTextColumn Header="Confidence"
                                        Binding="{Binding Confidence}"
                                        Width="100"/>

                                <DataGridTextColumn Header="Camera"
                                        Binding="{Binding Camera}"
                                        Width="90"/>

                                <DataGridTextColumn Header="Status"
                                        Binding="{Binding Status}"
                                        Width="100"/>

                            </DataGrid.Columns>

                        </DataGrid>

                    </StackPanel>

                </Border>


                <!-- Latest Evidence -->
                <Border Grid.Column="2"
            Style="{StaticResource Card}"
            Margin="0">

                    <StackPanel>

                        <!-- Header -->
                        <TextBlock Text="Latest Evidence"
                       FontSize="16"
                       FontWeight="SemiBold"
                       Foreground="#172B4D"/>

                        <TextBlock Text="Most recent detection"
                       FontSize="12"
                       Foreground="#8A99AA"
                       Margin="0,3,0,0"/>

                        <!-- Image Preview -->
                        <Border Height="190"
                    Background="#E8EEF5"
                    CornerRadius="8"
                    Margin="0,18,0,14"
                    ClipToBounds="True">

                            <Grid>

                                <TextBlock Text="Image preview"
                               Foreground="#8090A1"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>

                                <!-- Bounding box placeholder -->
                                <Border BorderBrush="#E04F5F"
                            BorderThickness="3"
                            Width="145"
                            Height="105"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"/>

                            </Grid>

                        </Border>

                        <!-- Evidence Information -->
                        <TextBlock Text="Motorcycle · No Helmet"
                       FontSize="14"
                       FontWeight="SemiBold"
                       Foreground="#172B4D"/>

                        <TextBlock Text="Confidence: 95% · Camera 1"
                       FontSize="12"
                       Foreground="#6B7C93"
                       Margin="0,5,0,0"/>

                    </StackPanel>

                </Border>

            </Grid>

        </StackPanel>
    </ScrollViewer>
</Page>