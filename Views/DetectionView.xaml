<Page x:Class="TrafficViolationDetection.Views.DetectionView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="#F4F7FB">

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">

        <StackPanel Margin="28">

            <!-- ===================================================== -->
            <!-- PAGE HEADER                                           -->
            <!-- ===================================================== -->

            <Grid Margin="0,0,0,20">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel>

                    <TextBlock Text="Detection"
                               FontSize="20"
                               FontWeight="SemiBold"
                               Foreground="#172B4D"/>

                    <TextBlock Text="Monitor camera feeds and detect traffic violations"
                               FontSize="13"
                               Foreground="#6B7C93"
                               Margin="0,5,0,0"/>

                </StackPanel>

                <!-- Detection status -->
                <Border Grid.Column="1"
                        Background="#E9F8F1"
                        CornerRadius="16"
                        Padding="12,6"
                        VerticalAlignment="Center">

                    <StackPanel Orientation="Horizontal">

                        <Ellipse Width="8"
                                 Height="8"
                                 Fill="#2FA875"
                                 VerticalAlignment="Center"/>

                        <TextBlock Text="Ready"
                                   Foreground="#25855E"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Margin="7,0,0,0"/>

                    </StackPanel>

                </Border>

            </Grid>


            <!-- ===================================================== -->
            <!-- MAIN CONTENT                                          -->
            <!-- ===================================================== -->

            <Grid>

                <Grid.ColumnDefinitions>

                    <!-- Video area -->
                    <ColumnDefinition Width="*"/>

                    <!-- Spacing -->
                    <ColumnDefinition Width="20"/>

                    <!-- Control sidebar -->
                    <ColumnDefinition Width="340"/>

                </Grid.ColumnDefinitions>


                <!-- ================================================= -->
                <!-- LEFT : VIDEO / CAMERA                             -->
                <!-- ================================================= -->

                <Border Grid.Column="0"
                        Background="White"
                        BorderBrush="#E4EAF0"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="16">

                    <Grid>

                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>


                        <!-- Video header -->

                        <Grid Margin="2,0,2,14">

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel>

                                <TextBlock Text="Live Preview"
                                           Foreground="#172B4D"
                                           FontSize="16"
                                           FontWeight="SemiBold"/>

                                <TextBlock Text="Camera 1"
                                           Foreground="#7A8CA2"
                                           FontSize="12"
                                           Margin="0,3,0,0"/>

                            </StackPanel>


                            <!-- Resolution indicator -->

                            <Border Grid.Column="1"
                                    Background="#F1F4F8"
                                    CornerRadius="5"
                                    Padding="9,5"
                                    VerticalAlignment="Center">

                                <TextBlock Text="1920 × 1080"
                                           FontSize="11"
                                           Foreground="#6B7C93"/>

                            </Border>

                        </Grid>


                        <!-- Video preview -->

                        <Border Grid.Row="1"
                                Background="#111923"
                                CornerRadius="8"
                                MinHeight="460"
                                ClipToBounds="True">

                            <Grid>

                                <!-- Placeholder -->

                                <StackPanel HorizontalAlignment="Center"
                                            VerticalAlignment="Center">

                                    <TextBlock Text="Camera / Video Preview"
                                               Foreground="#93A4B5"
                                               FontSize="15"
                                               HorizontalAlignment="Center"/>

                                    <TextBlock Text="Select a source and start detection"
                                               Foreground="#66798B"
                                               FontSize="12"
                                               Margin="0,7,0,0"
                                               HorizontalAlignment="Center"/>

                                </StackPanel>


                                <!-- Example detection bounding box -->

                                <Border Width="250"
                                        Height="180"
                                        BorderBrush="#FF4D5D"
                                        BorderThickness="3"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center">

                                    <Border.ToolTip>
                                        Detected: Motorcycle
                                    </Border.ToolTip>

                                </Border>


                                <!-- Top status -->

                                <Border HorizontalAlignment="Left"
                                        VerticalAlignment="Top"
                                        Background="#CC16202B"
                                        CornerRadius="5"
                                        Padding="9,6"
                                        Margin="14">

                                    <StackPanel Orientation="Horizontal">

                                        <Ellipse Width="8"
                                                 Height="8"
                                                 Fill="#55D69E"
                                                 VerticalAlignment="Center"/>

                                        <TextBlock Text="LIVE"
                                                   Foreground="White"
                                                   FontSize="11"
                                                   FontWeight="Bold"
                                                   Margin="7,0,0,0"/>

                                    </StackPanel>

                                </Border>


                                <!-- Bottom video information -->

                                <Border VerticalAlignment="Bottom"
                                        Background="#E6111923"
                                        Padding="16,13">

                                    <Grid>

                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>


                                        <StackPanel>

                                            <TextBlock Text="Motorcycle"
                                                       Foreground="White"
                                                       FontSize="14"
                                                       FontWeight="SemiBold"/>

                                            <TextBlock Text="Object detected"
                                                       Foreground="#9CB0C3"
                                                       FontSize="11"
                                                       Margin="0,3,0,0"/>

                                        </StackPanel>


                                        <StackPanel Grid.Column="1"
                                                    HorizontalAlignment="Right">

                                            <TextBlock Text="No Helmet"
                                                       Foreground="#FF767F"
                                                       FontWeight="SemiBold"
                                                       HorizontalAlignment="Right"/>

                                            <TextBlock Text="95% confidence"
                                                       Foreground="#FFCC66"
                                                       FontSize="11"
                                                       Margin="0,3,0,0"
                                                       HorizontalAlignment="Right"/>

                                        </StackPanel>

                                    </Grid>

                                </Border>

                            </Grid>

                        </Border>

                    </Grid>

                </Border>


                <!-- ================================================= -->
                <!-- RIGHT SIDEBAR                                     -->
                <!-- ================================================= -->

                <StackPanel Grid.Column="2">


                    <!-- ============================================= -->
                    <!-- DETECTION SOURCE                              -->
                    <!-- ============================================= -->

                    <Border Background="White"
                            BorderBrush="#E4EAF0"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="20"
                            Margin="0,0,0,16">

                        <StackPanel>

                            <TextBlock Text="Detection Source"
                                       FontSize="16"
                                       FontWeight="SemiBold"
                                       Foreground="#172B4D"/>

                            <TextBlock Text="Choose the source to analyze"
                                       FontSize="12"
                                       Foreground="#8A99AA"
                                       Margin="0,4,0,18"/>


                            <!-- Camera -->

                            <TextBlock Text="Camera"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Foreground="#42566C"
                                       Margin="0,0,0,7"/>

                            <ComboBox Height="38"
                                      Padding="8,4">

                                <ComboBoxItem Content="Camera 1"
                                              IsSelected="True"/>

                            </ComboBox>


                            <!-- OR -->

                            <Grid Margin="0,18">

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition/>
                                </Grid.ColumnDefinitions>

                                <Border Height="1"
                                        Background="#E4EAF0"
                                        VerticalAlignment="Center"/>

                                <TextBlock Grid.Column="1"
                                           Text="OR"
                                           Foreground="#98A6B5"
                                           FontSize="10"
                                           Margin="10,0"/>

                                <Border Grid.Column="2"
                                        Height="1"
                                        Background="#E4EAF0"
                                        VerticalAlignment="Center"/>

                            </Grid>


                            <!-- File -->

                            <TextBlock Text="Video or image file"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Foreground="#42566C"
                                       Margin="0,0,0,7"/>

                            <Button Content="Browse file..."
                                    Height="38"
                                    Background="White"
                                    Foreground="#42566C"
                                    BorderBrush="#CDD6E0"
                                    BorderThickness="1"
                                    Cursor="Hand"/>


                            <!-- Start Detection -->

                            <Button Content="Start Detection"
                                    Height="42"
                                    Style="{StaticResource PrimaryButton}"
                                    FontWeight="SemiBold"
                                    Margin="0,20,0,0"
                                    Cursor="Hand"/>


                            <!-- Stop Detection -->

                            <Button Content="Stop Detection"
                                    Height="40"
                                    Background="#FFF3F4"
                                    Foreground="#D64555"
                                    BorderBrush="#F1C4C9"
                                    BorderThickness="1"
                                    FontWeight="SemiBold"
                                    Margin="0,8,0,0"
                                    Cursor="Hand"/>

                        </StackPanel>

                    </Border>


                    <!-- ============================================= -->
                    <!-- CURRENT RESULT                                -->
                    <!-- ============================================= -->

                    <Border Background="White"
                            BorderBrush="#E4EAF0"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="20">

                        <StackPanel>

                            <Grid Margin="0,0,0,16">

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Text="Current Result"
                                           FontSize="16"
                                           FontWeight="SemiBold"
                                           Foreground="#172B4D"/>

                                <!-- Violation indicator -->

                                <Border Grid.Column="1"
                                        Background="#FFF0F1"
                                        CornerRadius="12"
                                        Padding="9,4">

                                    <TextBlock Text="VIOLATION"
                                               Foreground="#D64555"
                                               FontSize="10"
                                               FontWeight="Bold"/>

                                </Border>

                            </Grid>


                            <!-- Object -->

                            <Grid Margin="0,0,0,12">

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="110"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Text="Object"
                                           Foreground="#7A8CA2"
                                           FontSize="12"/>

                                <TextBlock Grid.Column="1"
                                           Text="Motorcycle"
                                           Foreground="#172B4D"
                                           FontSize="12"
                                           FontWeight="SemiBold"/>

                            </Grid>


                            <!-- Violation -->

                            <Grid Margin="0,0,0,12">

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="110"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Text="Violation"
                                           Foreground="#7A8CA2"
                                           FontSize="12"/>

                                <TextBlock Grid.Column="1"
                                           Text="No Helmet"
                                           Foreground="#D64555"
                                           FontSize="12"
                                           FontWeight="SemiBold"/>

                            </Grid>


                            <!-- Camera -->

                            <Grid Margin="0,0,0,12">

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="110"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Text="Camera"
                                           Foreground="#7A8CA2"
                                           FontSize="12"/>

                                <TextBlock Grid.Column="1"
                                           Text="Camera 1"
                                           Foreground="#172B4D"
                                           FontSize="12"/>

                            </Grid>


                            <!-- Confidence -->

                            <Grid Margin="0,0,0,7">

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Text="Confidence"
                                           Foreground="#7A8CA2"
                                           FontSize="12"/>

                                <TextBlock Grid.Column="1"
                                           Text="95%"
                                           Foreground="#2FA875"
                                           FontSize="12"
                                           FontWeight="SemiBold"/>

                            </Grid>

                            <ProgressBar Height="6"
                                         Minimum="0"
                                         Maximum="100"
                                         Value="95"
                                         Foreground="#2FA875"
                                         Background="#E6ECEF"/>


                            <!-- Separator -->

                            <Border Height="1"
                                    Background="#EDF0F4"
                                    Margin="0,17"/>


                            <!-- Bounding box -->

                            <TextBlock Text="Bounding Box"
                                       Foreground="#7A8CA2"
                                       FontSize="11"
                                       Margin="0,0,0,7"/>

                            <Border Background="#F6F8FA"
                                    CornerRadius="6"
                                    Padding="10">

                                <TextBlock Text="x:100   y:80   w:300   h:250"
                                           FontFamily="Consolas"
                                           FontSize="11"
                                           Foreground="#516578"/>

                            </Border>

                        </StackPanel>

                    </Border>

                </StackPanel>

            </Grid>

        </StackPanel>

    </ScrollViewer>

</Page>