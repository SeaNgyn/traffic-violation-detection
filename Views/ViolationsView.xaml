<Page x:Class="TrafficViolationDetection.Views.ViolationsView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="#F4F7FB">

    <Grid Margin="28">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- =============== FILTER BAR =============== -->
        <Border Style="{StaticResource Card}">
            <Grid>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Search & Filters -->
                <StackPanel Grid.Column="0"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">

                    <!-- Search -->
                    <TextBox Width="250"
                             Height="38"
                             Padding="12,8"
                             Text="Search violations..."
                             VerticalContentAlignment="Center"/>

                    <!-- Violation Type -->
                    <ComboBox Width="180"
                              Height="38"
                              Margin="12,0,0,0"
                              Padding="8,5"
                              VerticalContentAlignment="Center">

                        <ComboBoxItem Content="All violation types"
                                      IsSelected="True"/>

                    </ComboBox>

                    <!-- Date -->
                    <DatePicker Width="160"
                                Height="38"
                                Margin="12,0,0,0"
                                VerticalContentAlignment="Center"/>

                </StackPanel>


                <!-- Export Button -->
                <Button Grid.Column="1"
                        Content="Export Report"
                        Style="{StaticResource PrimaryButton}"
                        Width="130"
                        Height="38"
                        Margin="25,0,0,0"
                        VerticalAlignment="Center"/>

            </Grid>
        </Border>


        <!-- =============== VIOLATIONS TABLE =============== -->
        <Border Grid.Row="1"
                Style="{StaticResource Card}">

            <Grid>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Table Header -->
                <Grid Margin="0,0,0,16">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel>

                        <TextBlock Text="Detected Violations"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   Foreground="#172B4D"/>

                        <TextBlock Text="Review and manage detected traffic violations"
                                   FontSize="12"
                                   Foreground="#6B7C93"
                                   Margin="0,4,0,0"/>

                    </StackPanel>

                </Grid>


                <!-- Data Table -->
                <DataGrid Grid.Row="1"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          IsReadOnly="True"
                          HeadersVisibility="Column"
                          GridLinesVisibility="Horizontal"
                          BorderThickness="0"
                          RowHeight="48"
                          ColumnHeaderHeight="42"
                          AlternatingRowBackground="#F8FAFC">

                    <DataGrid.Columns>

                        <DataGridTextColumn Header="ID"
                                            Width="60"/>

                        <DataGridTextColumn Header="Evidence"
                                            Width="105"/>

                        <DataGridTextColumn Header="Object Type"
                                            Width="*"/>

                        <DataGridTextColumn Header="Violation Type"
                                            Width="*"/>

                        <DataGridTextColumn Header="Confidence"
                                            Width="110"/>

                        <DataGridTextColumn Header="Detected At"
                                            Width="165"/>

                        <DataGridTextColumn Header="Camera"
                                            Width="90"/>

                        <DataGridCheckBoxColumn Header="Processed"
                                                Width="95"/>

                        <!-- Action Button -->
                        <DataGridTemplateColumn Header="Action"
                                                Width="110">

                            <DataGridTemplateColumn.CellTemplate>

                                <DataTemplate>

                                    <Grid>
                                        <Button Content="Details"
                                                Width="78"
                                                Height="30"
                                                Padding="10,4"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"/>
                                    </Grid>

                                </DataTemplate>

                            </DataGridTemplateColumn.CellTemplate>

                        </DataGridTemplateColumn>

                    </DataGrid.Columns>

                </DataGrid>

            </Grid>

        </Border>

    </Grid>

</Page>